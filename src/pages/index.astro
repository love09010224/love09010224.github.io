---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile, skills, education, vulnerabilities } from '../data/portfolio';
---
<Layout title="Home" current="Home" description="Seojin An (love09010224)의 포트폴리오. 시스템 해킹, 리버스 엔지니어링과 오픈소스 취약점 연구의 기록입니다.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{profile.title}</p>
      <h1 id="hero-title"><span class="hero-greeting">Hello, I’m</span><br />Seojin An</h1>
      <p class="hero-description">시스템의 안쪽을 살피고,<br />더 안전한 소프트웨어를 고민합니다.</p>
      <p class="hero-affiliation">Undergraduate at the University of Seoul</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/achievements/">View achievements <Icon name="arrow" size={18} /></a>
        <a class="button button-text" href="/links/">Get in touch <Icon name="external" size={18} /></a>
      </div>
    </div>
    <figure class="portrait">
      <div class="portrait-art">
        <div class="portrait-frame"><Image src={portrait} alt="흰 모자와 베이지색 니트를 입고 웃고 있는 Seojin An의 캐릭터 초상" widths={[360, 540, 760]} sizes="(max-width: 600px) 260px, (max-width: 850px) 300px, 380px" width={380} height={475} format="webp" quality={85} loading="eager" fetchpriority="high" class="portrait-image" /></div>
        <span class="portrait-spark" aria-hidden="true"><Icon name="spark" size={42} /></span>
        <span class="portrait-sticker"><span aria-hidden="true">✳</span> Nice to meet you!</span>
      </div>
      <figcaption>{profile.handle}<span aria-hidden="true"> / </span>{profile.alias}</figcaption>
    </figure>
  </section>

  <section class="home-section" aria-labelledby="about-title">
    <SectionHeading number="01" title="About me" id="about-title" subtitle="조금 더 소개하자면" />
    <div class="home-section-content">
      <p class="about-copy">서울시립대학교 컴퓨터과학부에 재학 중인<br class="desktop-break" /> <strong>취약점 연구자</strong>입니다.</p>
      <p class="body-copy">시스템 해킹과 리버스 엔지니어링을 중심으로 공부하며,<br class="desktop-break" /> Linux Kernel LPE와 오픈소스 버그바운티에 관심이 있습니다.</p>
      <div class="interest-list" aria-label="관심 분야"><span><Icon name="terminal" size={17} />Linux Kernel LPE</span><span><Icon name="shield" size={17} />Open-Source Bug Bounty</span></div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="skills-title">
    <SectionHeading number="02" title="Skill set" id="skills-title" subtitle="관심 분야와 사용하는 기술" />
    <div class="home-section-content skill-groups">
      {skills.map((group) => <div class="skill-group"><h3>{group.category}</h3><ul class:list={['skill-list', { 'security-skills': group.category === 'Security' }]} role="list">{group.items.map((skill) => <li>{skill}</li>)}</ul></div>)}
    </div>
  </section>

  <section class="home-section" aria-labelledby="education-title">
    <SectionHeading number="03" title="Education" id="education-title" subtitle="배움의 발자취" />
    <ol class="education-list home-section-content" role="list">
      {education.map((item) => <li><div class="education-marker" aria-hidden="true"></div><div><div class="education-school"><h3>{item.school}</h3>{!item.end && <span class="status-badge">재학 중</span>}</div><p>{item.department}</p></div><span class="date-range">{item.start} — {item.end || '현재'}</span></li>)}
    </ol>
  </section>

  <section class="highlights-section" aria-labelledby="highlights-title">
    <SectionHeading number="04" title="Selected highlights" id="highlights-title"><a href="/achievements/" class="text-link">전체 기록 <Icon name="arrow" size={17} /></a></SectionHeading>
    <div class="highlights-grid">
      <a class="highlight-card" href="/achievements/#awards"><div class="highlight-top"><span class="eyebrow">CTF · 2026</span><Icon name="flag" /></div><div class="highlight-number">7<span>th place</span></div><h3>DEF CON 34 CTF Final</h3><p>Jinddabi's <Icon name="external" size={20} /></p></a>
      <a class="highlight-card" href="/achievements/#awards"><div class="highlight-top"><span class="eyebrow">CTF · 2026</span><Icon name="flag" /></div><div class="highlight-number">2<span>nd place</span></div><h3>Codegate 2026 Final</h3><p>General · 따따 <Icon name="external" size={20} /></p></a>
      <a class="highlight-card highlight-research" href="/achievements/#cves"><div class="highlight-top"><span class="eyebrow">Security research</span><Icon name="shield" /></div><div class="highlight-number">{vulnerabilities.length.toString().padStart(2, '0')}<span>CVEs</span></div><h3>Vulnerability disclosures</h3><p>OpenProject <Icon name="external" size={20} /></p></a>
    </div>
  </section>
</Layout>
